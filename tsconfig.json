{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"rootDir": "./src/main/java/META-INF/resources/ts",
		"outDir": "./src/main/java/META-INF/resources",
		"declaration": true,
		"declarationMap": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types":["jquery", "jqueryui"]
	},
	"include": [
		"src/main/java/META-INF/resources/ts/**/*.ts"
		, "src/main/java/META-INF/resources/ts/**/*.d.ts"
	],
	"exclude": []
}
